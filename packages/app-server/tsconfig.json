{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@release-toolkit/core": ["../core/src/index.ts"],
      "@release-toolkit/changelog-presets": ["../changelog-presets/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
