{
  "name": "@release-toolkit/app-server",
  "version": "0.0.0",
  "description": "GitHub App webhook server for release-toolkit (Cloudflare Worker)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "pnpm build && wrangler dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@release-toolkit/core": "workspace:*",
    "@release-toolkit/markdown": "workspace:*",
    "octokit": "^5.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260504.1",
    "wrangler": "4.94.0"
  }
}
