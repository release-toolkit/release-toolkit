{
  "name": "@release-toolkit/app-server",
  "version": "0.0.0",
  "description": "GitHub App webhook server for release-toolkit (Cloudflare Worker)",
  "type": "module",
  "main": "dist/index.mjs",
  "pnpm": {
    "overrides": {
      "@cloudflare/unenv-preset": "1.0.0",
      "unenv": "1.0.0"
    }
  },
  "scripts": {
    "dev": "pnpm build && wrangler dev",
    "build": "tsdown",
    "deploy": "tsdown && wrangler deploy",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@release-toolkit/core": "workspace:*",
    "octokit": "^5.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260518.0",
    "wrangler": "^4.89.0"
  }
}
