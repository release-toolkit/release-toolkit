{
  "name": "@release-toolkit/changelog-presets",
  "version": "0.0.0",
  "description": "Built-in changelog formatting presets — emoji prefixes, category grouping, and markdown styling",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "dev": "tsdown --config tsdown.config.ts --watch"
  },
  "files": ["dist", "README.md"],
  "peerDependencies": {
    "@release-toolkit/core": "workspace:*"
  },
  "dependencies": {}
}
