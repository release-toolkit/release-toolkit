{
  "name": "@release-toolkit/changelog-presets",
  "version": "0.0.0",
  "description": "Changelog formatters and presets for release-toolkit",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "dev": "tsdown --config tsdown.config.ts --watch",
    "type-check": "tsc --noEmit"
  },
  "files": ["dist", "README.md"],
  "dependencies": {
    "@release-toolkit/markdown": "workspace:*",
    "@release-toolkit/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0"
  }
}
