{
  "name": "@release-toolkit/changelog-presets",
  "version": "0.0.0",
  "description": "Built-in formatters: emoji-prefix, category-group, markdown-bold",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
