{
  "name": "@release-toolkit/core",
  "version": "0.0.0",
  "description": "Core library: version diff, changelog engine, plugin system, CI layer",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "scripts": {
    "build": "vite build && vite build --config vite.worker.config.ts",
    "dev": "vite build --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "js-yaml": "4.2.0",
    "semver": "^7.6.0",
    "simple-git": "^3.25.0",
    "@release-toolkit/changelog-presets": "workspace:*",
    "@release-toolkit/markdown": "workspace:*",
    "@release-toolkit/types": "workspace:*"
  },
  "optionalDependencies": {
    "octokit": "^5.0.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^25.6.0",
    "@types/semver": "^7.7.1"
  }
}
