{
  "name": "@release-toolkit/core",
  "version": "0.0.0",
  "description": "Core library: version diff, changelog engine, plugin system, CI layer",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "dev": "tsdown --config tsdown.config.ts --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "semver": "^7.6.0",
    "simple-git": "^3.25.0",
    "js-yaml": "^4.1.0"
  },
  "optionalDependencies": {
    "octokit": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/semver": "^7.7.1",
    "@types/js-yaml": "^4.0.0"
  }
}
