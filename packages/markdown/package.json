{
  "name": "@release-toolkit/markdown",
  "version": "0.0.0",
  "description": "Shared markdown utilities for release-toolkit (bullets, RELEASE-LOG parsing, emoji prefixes)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
