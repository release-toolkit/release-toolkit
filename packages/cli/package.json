{
  "name": "@release-toolkit/cli",
  "version": "0.0.0",
  "description": "CLI entry point for release-toolkit",
  "type": "module",
  "bin": {
    "release": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "dev": "tsdown --config tsdown.config.ts --watch",
    "type-check": "tsc --noEmit"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@release-toolkit/core": "workspace:*",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0"
  }
}
