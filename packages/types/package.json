{
  "name": "@release-toolkit/types",
  "version": "0.0.0",
  "description": "Shared TypeScript types for release-toolkit packages — types-only, zero runtime dependency",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "dev": "tsdown --config tsdown.config.ts --watch",
    "type-check": "tsc --noEmit"
  },
  "files": ["dist", "README.md"]
}
