{
  "name": "@release-toolkit/types",
  "version": "0.0.0",
  "description": "Shared TypeScript types for release-toolkit packages — types-only, zero runtime dependency",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "files": ["dist", "README.md"],
  "devDependencies": {
    "vitest": "^4.1.5"
  }
}
