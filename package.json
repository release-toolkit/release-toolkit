{
  "name": "release-toolkit",
  "private": true,
  "type": "module",
  "description": "CI-driven release CLI — version detection + changelog generation with plugin system",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "test": "pnpm -r test",
    "type-check": "pnpm -r exec tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "release": "node packages/cli/dist/index.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215",
  "keywords": [
    "monorepo",
    "release",
    "changelog",
    "version",
    "ci",
    "semver"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.0",
    "tsdown": "^0.21.10",
    "vitest": "^4.1.5",
    "eslint": "^9.0.0",
    "prettier": "^3.8.2",
    "@eslint/js": "^9.0.0",
    "globals": "^15.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0"
  }
}
